---
import { storyblokEditable } from '@storyblok/astro';

interface Props { blok: any; }
const { blok } = Astro.props;
---

<div {...storyblokEditable(blok)} class="process-step">
  <div class="process-step__number">{blok.number}</div>
  <div class="process-step__content">
    <h3>{blok.title}</h3>
    <p>{blok.description}</p>
  </div>
</div>

<style>
  .process-step {
    display: flex;
    gap: 28px;
    padding: 32px 0;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    align-items: flex-start;
  }
  .process-step:last-child { border-bottom: none; }
  .process-step__number {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.5);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: white;
    margin-bottom: 8px;
  }
  p {
    font-size: 0.92rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.7;
  }
</style>
