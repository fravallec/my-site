---
import { storyblokEditable } from '@storyblok/astro';

interface Props { blok: any; }
const { blok } = Astro.props;
---
<div {...storyblokEditable(blok)} class="brand-item">
  {blok.logo?.filename 
      ?<img src={blok.logo.filename} alt={blok.text} />
    : <span>{blok.text}</span>
  }
</div>

<style>
  .brand-item { display: flex; align-items: center; justify-content: center; }
  img {
    max-height: 44px;
    max-width: 140px;
    object-fit: contain;
    filter: grayscale(100%) opacity(0.5);
    transition: filter 0.2s;
  }
  img:hover { filter: grayscale(0%) opacity(1); }
  span { font-size: 1rem; font-weight: 700; color: rgb(37,49,64); opacity: 0.4; letter-spacing: 0.04em; }
</style>