---
import { storyblokEditable } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';

interface Props { blok: any; }
const { blok } = Astro.props;
---
<section {...storyblokEditable(blok)} class="faq">
  <div class="faq__container">
    <h2>{blok.title}</h2>
    <div class="faq__list">
      {blok.faq?.map((b: any) => <StoryblokComponent blok={b} />)}
    </div>
  </div>
</section>

<style>
  .faq { padding: 80px 20px; }
  .faq__container { max-width: 800px; margin: 0 auto; }
  .faq__list { margin-top: 40px; display: flex; flex-direction: column; gap: 16px; }
  h2 { font-size: 2rem; text-align: center; }
</style>