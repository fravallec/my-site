---
import { storyblokEditable } from '@storyblok/astro';

interface Props { blok: any; }
const { blok } = Astro.props;
---

<div {...storyblokEditable(blok)} class="benefit-item">
  <div class="benefit-item__icon">✓</div>
  <h3>{blok.title}</h3>
  <p>{blok.description}</p>
</div>

<style>
  .benefit-item {
    padding: 28px;
    border: 1px solid rgba(37,49,64,0.08);
    border-radius: 8px;
    background: #fafafa;
  }
  .benefit-item__icon {
    width: 36px;
    height: 36px;
    background: rgb(37,49,64);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 16px;
  }
  h3 {
    font-size: 1rem;
    font-weight: 700;
    color: rgb(37,49,64);
    margin-bottom: 8px;
  }
  p {
    font-size: 0.9rem;
    color: #666;
    line-height: 1.65;
  }
</style>
