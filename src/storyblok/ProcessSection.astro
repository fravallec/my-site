---
import { storyblokEditable } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';

interface Props { blok: any; }
const { blok } = Astro.props;
---

<section {...storyblokEditable(blok)} class="process">
  <div class="process__container">
    <h2>{blok.title}</h2>
    {blok.subtitle && <p class="process__subtitle">{blok.subtitle}</p>}
    <div class="process__steps">
      {blok.steps?.map((b: any) => <StoryblokComponent blok={b} />)}
    </div>
  </div>
</section>

<style>
  .process { padding: 80px 20px; background: rgb(37,49,64); }
  .process__container { max-width: 1140px; margin: 0 auto; }
  h2 {
    font-size: 2.2rem;
    font-weight: 700;
    color: white;
    text-align: center;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  .process__subtitle {
    text-align: center;
    color: rgba(255,255,255,0.55);
    font-size: 1rem;
    margin-bottom: 56px;
    line-height: 1.6;
  }
  .process__steps {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 56px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }
</style>
