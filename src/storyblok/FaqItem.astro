---
import { storyblokEditable } from '@storyblok/astro';

interface Props { blok: any; }
const { blok } = Astro.props;
---

<details {...storyblokEditable(blok)} class="faq-item">
  <summary class="faq-item__trigger">
    <span>{blok.question}</span>
    <svg class="faq-item__icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <line x1="12" y1="5" x2="12" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="faq-item__icon-v"/>
      <line x1="5" y1="12" x2="19" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </summary>
  <div class="faq-item__body">
    <p>{blok.answer}</p>
  </div>
</details>

<style>
  .faq-item {
    border-bottom: 1px solid rgba(37,49,64,0.1);
  }
  /* Remove default triangle */
  .faq-item__trigger {
    list-style: none;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 0;
    cursor: pointer;
    text-align: left;
    color: rgb(37,49,64);
    font-family: inherit;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
    user-select: none;
  }
  .faq-item__trigger::-webkit-details-marker { display: none; }
  .faq-item__trigger:hover { opacity: 0.75; }

  .faq-item__icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: rgb(37,49,64);
    opacity: 0.5;
    transition: transform 0.25s ease;
  }
  .faq-item__icon-v {
    transition: transform 0.25s ease, opacity 0.25s ease;
    transform-origin: center;
  }
  .faq-item[open] .faq-item__icon-v {
    transform: scaleY(0);
    opacity: 0;
  }

  .faq-item__body {
    overflow: hidden;
  }
  .faq-item__body p {
    color: #555;
    line-height: 1.75;
    font-size: 0.95rem;
    padding-bottom: 22px;
  }
</style>
