---
import { storyblokEditable } from '@storyblok/astro';

interface Props { blok: any; }
const { blok } = Astro.props;
---
<div {...storyblokEditable(blok)} class="testimonial-item">
  <p class="quote">"{blok.quote}"</p>
  <p class="author">— {blok.author}, {blok.company}</p>
</div>

<style>
  .testimonial-item { background: rgba(255,255,255,0.1); padding: 30px; border-radius: 8px; text-align: left; }
  .quote { color: white; font-size: 1rem; line-height: 1.7; font-style: italic; }
  .author { color: rgba(255,255,255,0.7); margin-top: 16px; font-weight: 600; }
</style>