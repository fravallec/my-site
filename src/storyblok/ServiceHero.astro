---
import { storyblokEditable } from '@storyblok/astro';

interface Props { blok: any; }
const { blok } = Astro.props;

const icons: Record<string, string> = {
  'technical-seo': `
    <svg viewBox="0 0 240 240" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <!-- Site architecture nodes -->
      <rect x="100" y="20" width="40" height="28" rx="4" stroke="rgba(255,255,255,0.25)" stroke-width="2"/>
      <line x1="120" y1="48" x2="80" y2="80" stroke="rgba(255,255,255,0.15)" stroke-width="1.5"/>
      <line x1="120" y1="48" x2="160" y2="80" stroke="rgba(255,255,255,0.15)" stroke-width="1.5"/>
      <line x1="120" y1="48" x2="120" y2="80" stroke="rgba(255,255,255,0.15)" stroke-width="1.5"/>
      <rect x="56" y="80" width="48" height="28" rx="4" stroke="rgba(255,255,255,0.2)" stroke-width="2"/>
      <rect x="96" y="80" width="48" height="28" rx="4" stroke="rgba(255,255,255,0.2)" stroke-width="2"/>
      <rect x="136" y="80" width="48" height="28" rx="4" stroke="rgba(255,255,255,0.2)" stroke-width="2"/>
      <!-- Code brackets -->
      <text x="30" y="170" font-family="monospace" font-size="28" fill="rgba(255,255,255,0.12)" font-weight="700">&lt;/&gt;</text>
      <!-- Magnifying glass -->
      <circle cx="160" cy="170" r="38" stroke="rgba(255,255,255,0.22)" stroke-width="8"/>
      <line x1="188" y1="198" x2="210" y2="222" stroke="rgba(255,255,255,0.22)" stroke-width="8" stroke-linecap="round"/>
      <!-- Search line inside magnifier -->
      <line x1="142" y1="163" x2="178" y2="163" stroke="rgba(255,255,255,0.12)" stroke-width="3" stroke-linecap="round"/>
      <line x1="142" y1="173" x2="168" y2="173" stroke="rgba(255,255,255,0.12)" stroke-width="3" stroke-linecap="round"/>
    </svg>`,

  'geo-ai-seo': `
    <svg viewBox="0 0 240 240" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <!-- Brain outline -->
      <circle cx="120" cy="110" r="60" stroke="rgba(255,255,255,0.18)" stroke-width="2" stroke-dasharray="6 4"/>
      <!-- Network nodes inside -->
      <circle cx="120" cy="80" r="5" fill="rgba(255,255,255,0.3)"/>
      <circle cx="90" cy="110" r="5" fill="rgba(255,255,255,0.3)"/>
      <circle cx="150" cy="110" r="5" fill="rgba(255,255,255,0.3)"/>
      <circle cx="105" cy="140" r="5" fill="rgba(255,255,255,0.3)"/>
      <circle cx="135" cy="140" r="5" fill="rgba(255,255,255,0.3)"/>
      <!-- Connections -->
      <line x1="120" y1="80" x2="90" y2="110" stroke="rgba(255,255,255,0.15)" stroke-width="1.5"/>
      <line x1="120" y1="80" x2="150" y2="110" stroke="rgba(255,255,255,0.15)" stroke-width="1.5"/>
      <line x1="90" y1="110" x2="105" y2="140" stroke="rgba(255,255,255,0.15)" stroke-width="1.5"/>
      <line x1="150" y1="110" x2="135" y2="140" stroke="rgba(255,255,255,0.15)" stroke-width="1.5"/>
      <line x1="105" y1="140" x2="135" y2="140" stroke="rgba(255,255,255,0.15)" stroke-width="1.5"/>
      <line x1="90" y1="110" x2="150" y2="110" stroke="rgba(255,255,255,0.15)" stroke-width="1.5"/>
      <!-- AI label -->
      <text x="98" y="225" font-family="sans-serif" font-size="14" fill="rgba(255,255,255,0.18)" font-weight="700" letter-spacing="4">AI</text>
      <!-- Outer signal rings -->
      <circle cx="120" cy="110" r="80" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
      <circle cx="120" cy="110" r="100" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
    </svg>`,

  'javascript-seo': `
    <svg viewBox="0 0 240 240" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <!-- Code window frame -->
      <rect x="20" y="40" width="200" height="160" rx="8" stroke="rgba(255,255,255,0.2)" stroke-width="2"/>
      <line x1="20" y1="68" x2="220" y2="68" stroke="rgba(255,255,255,0.12)" stroke-width="1.5"/>
      <!-- Window dots -->
      <circle cx="38" cy="54" r="4" fill="rgba(255,255,255,0.15)"/>
      <circle cx="54" cy="54" r="4" fill="rgba(255,255,255,0.15)"/>
      <circle cx="70" cy="54" r="4" fill="rgba(255,255,255,0.15)"/>
      <!-- JS brackets -->
      <text x="50" y="140" font-family="monospace" font-size="52" fill="rgba(255,255,255,0.18)" font-weight="700">&lt;/&gt;</text>
      <!-- Code lines -->
      <line x1="40" y1="160" x2="110" y2="160" stroke="rgba(255,255,255,0.1)" stroke-width="2" stroke-linecap="round"/>
      <line x1="40" y1="175" x2="80" y2="175" stroke="rgba(255,255,255,0.08)" stroke-width="2" stroke-linecap="round"/>
    </svg>`,

  'web-migration': `
    <svg viewBox="0 0 240 240" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <!-- Left server -->
      <rect x="20" y="80" width="70" height="80" rx="6" stroke="rgba(255,255,255,0.22)" stroke-width="2"/>
      <line x1="20" y1="105" x2="90" y2="105" stroke="rgba(255,255,255,0.1)" stroke-width="1.5"/>
      <line x1="20" y1="130" x2="90" y2="130" stroke="rgba(255,255,255,0.1)" stroke-width="1.5"/>
      <circle cx="34" cy="93" r="3" fill="rgba(255,255,255,0.2)"/>
      <circle cx="34" cy="118" r="3" fill="rgba(255,255,255,0.2)"/>
      <circle cx="34" cy="143" r="3" fill="rgba(255,255,255,0.2)"/>
      <!-- Right server -->
      <rect x="150" y="80" width="70" height="80" rx="6" stroke="rgba(255,255,255,0.22)" stroke-width="2"/>
      <line x1="150" y1="105" x2="220" y2="105" stroke="rgba(255,255,255,0.1)" stroke-width="1.5"/>
      <line x1="150" y1="130" x2="220" y2="130" stroke="rgba(255,255,255,0.1)" stroke-width="1.5"/>
      <circle cx="164" cy="93" r="3" fill="rgba(255,255,255,0.2)"/>
      <circle cx="164" cy="118" r="3" fill="rgba(255,255,255,0.2)"/>
      <circle cx="164" cy="143" r="3" fill="rgba(255,255,255,0.2)"/>
      <!-- Arrow right -->
      <line x1="98" y1="120" x2="142" y2="120" stroke="rgba(255,255,255,0.3)" stroke-width="2.5" stroke-linecap="round"/>
      <polyline points="132,110 144,120 132,130" stroke="rgba(255,255,255,0.3)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      <!-- Arrow left (smaller, faded) -->
      <line x1="108" y1="108" x2="132" y2="108" stroke="rgba(255,255,255,0.1)" stroke-width="1.5" stroke-linecap="round"/>
      <polyline points="120,102 108,108 120,114" stroke="rgba(255,255,255,0.1)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    </svg>`,

  'headless-seo': `
    <svg viewBox="0 0 240 240" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <!-- Top layer (frontend) -->
      <rect x="40" y="30" width="160" height="44" rx="6" stroke="rgba(255,255,255,0.25)" stroke-width="2"/>
      <text x="72" y="58" font-family="monospace" font-size="12" fill="rgba(255,255,255,0.2)">Frontend</text>
      <!-- Disconnected line -->
      <line x1="120" y1="74" x2="120" y2="96" stroke="rgba(255,255,255,0.1)" stroke-width="2" stroke-dasharray="4 4"/>
      <!-- Break symbol -->
      <circle cx="120" cy="98" r="8" fill="rgb(37,49,64)" stroke="rgba(255,255,255,0.2)" stroke-width="1.5"/>
      <line x1="116" y1="94" x2="124" y2="102" stroke="rgba(255,255,255,0.25)" stroke-width="1.5" stroke-linecap="round"/>
      <line x1="124" y1="94" x2="116" y2="102" stroke="rgba(255,255,255,0.25)" stroke-width="1.5" stroke-linecap="round"/>
      <!-- Middle layer (API) -->
      <rect x="40" y="106" width="160" height="44" rx="6" stroke="rgba(255,255,255,0.18)" stroke-width="2"/>
      <text x="88" y="134" font-family="monospace" font-size="12" fill="rgba(255,255,255,0.15)">API</text>
      <!-- Connected line -->
      <line x1="120" y1="150" x2="120" y2="162" stroke="rgba(255,255,255,0.15)" stroke-width="2"/>
      <!-- Bottom layer (CMS) -->
      <rect x="40" y="162" width="160" height="44" rx="6" stroke="rgba(255,255,255,0.12)" stroke-width="2"/>
      <text x="80" y="190" font-family="monospace" font-size="12" fill="rgba(255,255,255,0.12)">CMS</text>
    </svg>`,
};

const icon = icons[blok.icon] ?? '';
---

<section {...storyblokEditable(blok)} class="service-hero">
  <div class="service-hero__container">
    <div class="service-hero__content">
      <span class="service-hero__label">{blok.label}</span>
      <h1>{blok.title}</h1>
      <p>{blok.subtitle}</p>
      <a href="/contact" class="service-hero__cta">{blok.cta_text || 'Get in touch'}</a>
    </div>
    {icon && (
      <div class="service-hero__icon" set:html={icon} />
    )}
  </div>
</section>

<style>
  .service-hero {
    background: rgb(37,49,64);
    padding: 80px 20px;
  }
  .service-hero__container {
    max-width: 1140px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .service-hero__label {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
    margin-bottom: 16px;
  }
  h1 {
    font-size: 2.8rem;
    font-weight: 700;
    color: white;
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }
  p {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.7);
    line-height: 1.7;
    margin-bottom: 36px;
  }
  .service-hero__cta {
    display: inline-block;
    background: white;
    color: rgb(37,49,64);
    padding: 14px 28px;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .service-hero__cta:hover { opacity: 0.88; }
  .service-hero__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.9;
  }
  .service-hero__icon svg {
    width: 100%;
    max-width: 320px;
    height: auto;
  }
  @media (max-width: 900px) {
    .service-hero__container { grid-template-columns: 1fr; }
    .service-hero__icon { display: none; }
    h1 { font-size: 2rem; }
  }
</style>
