---
import { storyblokEditable } from '@storyblok/astro';

interface Props { blok: any; }
const { blok } = Astro.props;
---

<section {...storyblokEditable(blok)} class="about">
  <div class="about__container">
    <div class="about__top">
      <div class="about__icon">
        <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <!-- Upward trend line -->
          <polyline
            points="20,160 60,110 100,130 140,60 175,30"
            stroke="rgba(255,255,255,0.15)"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <!-- Data points -->
          <circle cx="20" cy="160" r="4" fill="rgba(255,255,255,0.2)" />
          <circle cx="60" cy="110" r="4" fill="rgba(255,255,255,0.2)" />
          <circle cx="100" cy="130" r="4" fill="rgba(255,255,255,0.2)" />
          <circle cx="140" cy="60" r="4" fill="rgba(255,255,255,0.3)" />
          <circle cx="175" cy="30" r="4" fill="rgba(255,255,255,0.3)" />
          <!-- Magnifying glass circle -->
          <circle
            cx="110"
            cy="95"
            r="52"
            stroke="rgba(255,255,255,0.22)"
            stroke-width="10"
          />
          <!-- Magnifying glass handle -->
          <line
            x1="150"
            y1="135"
            x2="178"
            y2="165"
            stroke="rgba(255,255,255,0.22)"
            stroke-width="10"
            stroke-linecap="round"
          />
          <!-- Inner highlight on magnifier -->
          <circle
            cx="110"
            cy="95"
            r="36"
            stroke="rgba(255,255,255,0.06)"
            stroke-width="1"
          />
        </svg>
      </div>
      <div class="about__header">
        <h2 class="about__heading">{blok.headline}</h2>
        <div class="about__rule"></div>
      </div>
    </div>
    <div class="about__columns">
      <div class="about__col-left">
        <p class="about__lead">{blok.lead}</p>
        <p class="about__body1">{blok.body}</p>
        {blok.cta_text && blok.cta_link && (
          <a href={blok.cta_link} class="about__cta">{blok.cta_text}</a>
        )}
      </div>
      <div class="about__col-right">
        <p>{blok.body2}</p>
        <p>{blok.body3}</p>
        <p>{blok.body4}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding: 80px 20px;
    background: rgb(37,49,64);
    color: white;
  }
  .about__container {
    max-width: 1140px;
    margin: 0 auto;
  }
  .about__top {
    display: flex;
    align-items: center;
    gap: 48px;
    margin-bottom: 48px;
  }
  .about__icon {
    flex-shrink: 0;
    width: 160px;
    height: 160px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .about__icon svg {
    width: 100%;
    height: 100%;
  }
  .about__header {
    flex: 1;
  }
  .about__heading {
    font-size: 2.8rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: white;
    margin-bottom: 20px;
    text-align: left;
  }
  .about__rule {
    width: 60px;
    height: 3px;
    background: rgba(255,255,255,0.25);
    margin-top: 16px;
  }
  .about__columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }
  .about__lead {
    font-size: 1.2rem;
    font-weight: 600;
    color: white;
    line-height: 1.55;
    margin-bottom: 20px;
  }
  .about__body1 {
    font-size: 1rem;
    color: rgba(255,255,255,0.7);
    line-height: 1.75;
    margin-bottom: 36px;
  }
  .about__cta {
    display: block;
    text-align: center;
    background: white;
    color: rgb(37,49,64);
    padding: 15px 28px;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .about__cta:hover { opacity: 0.88; }
  .about__col-right p {
    font-size: 0.95rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.8;
    margin-bottom: 20px;
  }
  .about__col-right p:last-child { margin-bottom: 0; }

  @media (max-width: 768px) {
    .about__heading { font-size: 2rem; }
    .about__columns { grid-template-columns: 1fr; gap: 36px; }
  }
</style>
