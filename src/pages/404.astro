---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found | Francesco Vallecoccia">
  <section class="not-found">
    <div class="not-found__container">
      <span class="not-found__code">404</span>
      <h1>This page is being built</h1>
      <p>I'm working on this section of the site. In the meantime, feel free to explore the homepage or get in touch.</p>
      <div class="not-found__actions">
        <a href="/" class="not-found__cta not-found__cta--primary">Back to Homepage</a>
        <a href="/contact" class="not-found__cta not-found__cta--secondary">Get in Touch</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    min-height: calc(100vh - 64px - 320px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    background: #fff;
  }
  .not-found__container {
    max-width: 560px;
    text-align: center;
  }
  .not-found__code {
    display: block;
    font-size: 7rem;
    font-weight: 800;
    color: rgb(37,49,64);
    opacity: 0.08;
    line-height: 1;
    margin-bottom: 24px;
    letter-spacing: -0.04em;
  }
  h1 {
    font-size: 2.2rem;
    font-weight: 700;
    color: rgb(37,49,64);
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }
  p {
    font-size: 1rem;
    color: #666;
    line-height: 1.7;
    margin-bottom: 40px;
  }
  .not-found__actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .not-found__cta {
    display: inline-block;
    padding: 14px 28px;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s;
  }
  .not-found__cta--primary {
    background: rgb(37,49,64);
    color: white;
  }
  .not-found__cta--primary:hover { opacity: 0.85; }
  .not-found__cta--secondary {
    background: transparent;
    color: rgb(37,49,64);
    border: 1px solid rgba(37,49,64,0.25);
  }
  .not-found__cta--secondary:hover {
    border-color: rgb(37,49,64);
  }
</style>
