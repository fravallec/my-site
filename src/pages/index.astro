---
import Layout from '../layouts/Layout.astro';
import { useStoryblokApi } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';

const storyblokApi = useStoryblokApi();

const { data } = await storyblokApi.get('cdn/stories/home', {
  version: 'draft',
});

const story = data.story;
---
<Layout
  title="Technical SEO Consultant London | Fravallec"
  description="Francesco Vallecoccia — freelance technical SEO and Google Ads consultant in London. I help businesses rank, get found and grow through search. Get in touch."
>
  <StoryblokComponent blok={story.content} />
</Layout>
